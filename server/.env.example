PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shelflife?retryWrites=true&w=majority
JWT_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=https://your-web-domain.com
ADMIN_JOB_SECRET=replace_with_random_admin_job_secret

# Cloudinary (Required in production for persistent image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Spoonacular API (150 free requests/day)
SPOONACULAR_API_KEY=your_spoonacular_api_key

# Vision AI for Receipt / Shop Bill Scanning (Gemini or OpenAI-compatible)
GEMINI_API_KEY=your_gemini_api_key
